<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HCPlayer.SettingsPage" Loaded="SettingsLoaded">

    <Page.Resources>
        <ResourceDictionary>
            <!-- A solid WinUI surface is intentional here. Host-backdrop acrylic
             samples the video HWND and produces a visible transport-height tone change. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SettingsSurface" Color="#FF202328"/>
                    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF272A30"/>
                    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SettingsSurfaceWindows11" Color="#FF202020"/>
                    <SolidColorBrush x:Key="SettingsCardBrushWindows11" Color="#FF2B2B2B"/>
                    <SolidColorBrush x:Key="SettingsCardBorderBrushWindows11" Color="Transparent"/>
                    <SolidColorBrush x:Key="TechnicalBadgeBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="TechnicalBadgeBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SettingsButtonBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SettingsButtonBackgroundBrush" Color="#14FFFFFF"/>
                    <Thickness x:Key="SettingsButtonBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#44FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#54FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#38FFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4AFFFFFF"/>
                    <SolidColorBrush x:Key="SettingsButtonPointerOverBrush" Color="#38FFFFFF"/>
                    <SolidColorBrush x:Key="SettingsButtonPressedBrush" Color="#4AFFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsSurface" Color="#FFF5F5F5"/>
                    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SettingsSurfaceWindows11" Color="#FFF3F3F3"/>
                    <SolidColorBrush x:Key="SettingsCardBrushWindows11" Color="#FFFBFBFB"/>
                    <SolidColorBrush x:Key="SettingsCardBorderBrushWindows11" Color="#16000000"/>
                    <SolidColorBrush x:Key="TechnicalBadgeBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="TechnicalBadgeBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SettingsButtonBorderBrush" Color="#28000000"/>
                    <SolidColorBrush x:Key="SettingsButtonBackgroundBrush" Color="Transparent"/>
                    <Thickness x:Key="SettingsButtonBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="SettingsButtonPointerOverBrush" Color="#0F000000"/>
                    <SolidColorBrush x:Key="SettingsButtonPressedBrush" Color="#18000000"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SettingsCardBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16,13"/>
            </Style>
            <Style x:Key="SettingsCardWindows11" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SettingsCardBrushWindows11}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsCardBorderBrushWindows11}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="16,13"/>
            </Style>
            <Style x:Key="TechnicalBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TechnicalBadgeBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource TechnicalBadgeBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ShortcutKeyBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TechnicalBadgeBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource TechnicalBadgeBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="MinWidth" Value="42"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ShortcutSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Opacity" Value="0.72"/>
                <Setter Property="Margin" Value="0,4,0,2"/>
            </Style>
            <Style x:Key="ImportedCountBadge" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource TechnicalBadgeBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource TechnicalBadgeBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="7,2"/>
            </Style>
            <!-- Text fields in this page use normal keyboard editing.  This lean
             template intentionally omits WinUI's redundant clear (X) button. -->
            <Style x:Key="NoClearTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="BorderElement.Opacity" Value="0.56"/>
                                                <Setter Target="ContentElement.Opacity" Value="0.56"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}"/>
                                                <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushPointerOver}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundFocused}"/>
                                                <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}"/>
                                                <Setter Target="BorderElement.BorderThickness" Value="{ThemeResource TextControlBorderThemeThicknessFocused}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="BorderElement" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Control.IsTemplateFocusTarget="True" MinWidth="{TemplateBinding MinWidth}" MinHeight="{TemplateBinding MinHeight}"/>
                                <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden" IsTabStop="False" ZoomMode="Disabled"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource NoClearTextBox}"/>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource SettingsButtonBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{ThemeResource SettingsButtonBorderThickness}"/>
                <Setter Property="Background" Value="{ThemeResource SettingsButtonBackgroundBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <!-- The stock template resolves its hover brushes inside
                 generic.xaml. Keep the same compact presenter, but own the
                 state backgrounds here so page-local dark resources apply. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="SettingsButtonPresenter" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083"/>
                                </ContentPresenter.BackgroundTransition>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SettingsButtonPresenter.Background" Value="{ThemeResource SettingsButtonPointerOverBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SettingsButtonPresenter.Background" Value="{ThemeResource SettingsButtonPressedBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SettingsButtonPresenter.Opacity" Value="0.42"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CompactValueTextBox" TargetType="TextBox" BasedOn="{StaticResource NoClearTextBox}">
                <Setter Property="Width" Value="72"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MaxLength" Value="6"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>
            <Style TargetType="ToggleSwitch">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <!-- WinUI reserves extra width inside ToggleSwitch for its labels.
                 Constrain that invisible area so the track and state text move
                 together, freeing space for the technical badge on the left. -->
                <Setter Property="Width" Value="128"/>
                <!-- Anchor both labels immediately after the track. Right-aligned
                 content made the shorter "Ativado" drift away while the wider
                 "Desativado" happened to look correct. -->
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Margin" Value="14,0,-6,0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <!-- This stationary surface is resolved after Page.Resources exists. It
         prevents a black flash while the inner panel uses its compositor
         translation, without putting a ThemeResource on Page itself. -->
    <Grid x:Name="SettingsSurfaceHost" Background="{ThemeResource SettingsSurface}">
        <Border x:Name="SettingsRoot" Background="{ThemeResource SettingsSurface}" BorderThickness="0" CornerRadius="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SettingsTranslate" X="0"/>
            </Border.RenderTransform>
            <Grid Padding="22,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="SettingsHeader" Margin="0,0,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Uid="SettingsTitle" Text="Configurações" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="HC Player" Margin="0,3,0,0" Opacity="0.62"/>
                        <TextBlock x:Uid="SettingsIntro" Text="Edite as opções e clique em Salvar para aplicá-las" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Opacity="0.48"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton" Click="SaveClicked" Padding="14,8" CornerRadius="8" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="" FontSize="14"/>
                                <TextBlock x:Uid="SettingsSave" Text="Salvar"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeButton" Click="ThemeClicked" Width="38" Height="38" Padding="0" CornerRadius="8">
                            <FontIcon x:Name="ThemeIcon" Glyph="" FontSize="16"/>
                        </Button>
                        <Button x:Uid="SettingsB001" Click="CloseClicked" Width="38" Height="38" CornerRadius="8" ToolTipService.ToolTip="Fechar">
                            <FontIcon Glyph="" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="SaveStatus" Grid.Row="1" Margin="0,0,22,12" IsOpen="False" IsClosable="True"/>

                <Grid x:Name="SettingsTabs" Grid.Row="2" Margin="0,0,22,12" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GeneralTabButton" Grid.Column="0" Tag="general" Click="SettingsTabClicked" Padding="4,7,4,8" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="SettingsTabGeneral" x:Name="GeneralTabText" Text="Geral" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="1"/>
                            <Border x:Name="GeneralTabIndicator" Grid.Row="1" Height="2" Width="28" Margin="0,6,0,0" CornerRadius="1" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Visible"/>
                        </Grid>
                    </Button>
                    <Button x:Name="PlaybackTabButton" Grid.Column="1" Tag="playback" Click="SettingsTabClicked" Padding="4,7,4,8" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="SettingsTabPlayback" x:Name="PlaybackTabText" Text="Reprodução" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="0.68"/>
                            <Border x:Name="PlaybackTabIndicator" Grid.Row="1" Height="2" Width="28" Margin="0,6,0,0" CornerRadius="1" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MediaTabButton" Grid.Column="2" Tag="media" Click="SettingsTabClicked" Padding="4,7,4,8" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="SettingsTabMedia" x:Name="MediaTabText" Text="Mídia" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="0.68"/>
                            <Border x:Name="MediaTabIndicator" Grid.Row="1" Height="2" Width="28" Margin="0,6,0,0" CornerRadius="1" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="InterfaceTabButton" Grid.Column="3" Tag="interface" Click="SettingsTabClicked" Padding="4,7,4,8" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="SettingsTabInterface" x:Name="InterfaceTabText" Text="Interface" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="0.68"/>
                            <Border x:Name="InterfaceTabIndicator" Grid.Row="1" Height="2" Width="28" Margin="0,6,0,0" CornerRadius="1" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="AdvancedTabButton" Grid.Column="4" Tag="advanced" Click="SettingsTabClicked" Padding="4,7,4,8" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="SettingsTabAdvanced" x:Name="AdvancedTabText" Text="Avançado" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="0.68"/>
                            <Border x:Name="AdvancedTabIndicator" Grid.Row="1" Height="2" Width="28" Margin="0,6,0,0" CornerRadius="1" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="AboutTabButton" Grid.Column="5" Tag="about" Click="SettingsTabClicked" Padding="4,7,4,8" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Uid="SettingsTabAbout" x:Name="AboutTabText" Text="Sobre" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" Opacity="0.68"/>
                            <Border x:Name="AboutTabIndicator" Grid.Row="1" Height="2" Width="28" Margin="0,6,0,0" CornerRadius="1" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="3" Padding="0" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" IsTabStop="True">
                    <!-- Keep the cards clear of the standard Fluent overlay bar. -->
                    <StackPanel Spacing="12" Margin="0,0,22,12">
                        <StackPanel x:Name="GeneralSettingsPanel" Spacing="12" Visibility="Visible">

                            <TextBlock x:Uid="SettingsB002" Text="JANELA" Margin="4,10,0,0" FontSize="13" FontWeight="SemiBold" Opacity="0.65"/>

                            <Border x:Name="AlwaysOnTopCard" Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="SettingsB003" Text="Sempre visível" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="SettingsB004" Text="Mantém o player acima das outras janelas" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AlwaysOnTopToggle" Grid.Column="1" Tag="ui-ontop" Toggled="AlwaysOnTopToggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="InstanceModeCard" Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsInstanceModeTitle" Text="Instâncias do aplicativo" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="SettingsInstanceModeDescription" Text="Define se novas aberturas reutilizam a janela atual ou criam outra" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/>
                                    </StackPanel>
                                    <ComboBox x:Name="InstanceModeCombo" Grid.Column="1" Width="190" Tag="ui-instance-mode" SelectedIndex="0" SelectionChanged="TimelineStyleChanged" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="SettingsInstanceModeSingle" Content="Uma única instância" Tag="single"/>
                                        <ComboBoxItem x:Uid="SettingsInstanceModeMultiple" Content="Várias instâncias" Tag="multiple"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border x:Name="WindowFollowVideoCard" Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsWindowFollowVideoTitle" Text="Ajustar janela ao vídeo" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="SettingsWindowFollowVideoDescription" Text="Adapta dinamicamente o tamanho e a proporção da janela à mídia" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="WindowFollowVideoToggle" Grid.Column="1" Tag="ui-window-follow-video" IsOn="False" Toggled="InterfaceVisibilityToggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="RememberWindowSizeCard" Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsRememberWindowSizeTitle" Text="Lembrar tamanho da janela" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="SettingsRememberWindowSizeDescription" Text="Restaura o último tamanho normal usado ao abrir o HC Player" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RememberWindowSizeToggle" Grid.Column="1" Tag="ui-window-remember-size" IsOn="False" Toggled="InterfaceVisibilityToggled" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="WindowNativePanel" Spacing="12"/>

                            <TextBlock x:Uid="SettingsWindowsIntegrationSection" Text="WINDOWS" Margin="4,10,0,0" FontSize="13" FontWeight="SemiBold" Opacity="0.65"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsDefaultPlayerTitle" Text="Player de mídia padrão" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="SettingsDefaultPlayerDescription" Text="Abra as Configurações do Windows para escolher o HC Player como padrão nos formatos compatíveis" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="OpenDefaultAppsClicked" Padding="11,7" CornerRadius="8" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                            <TextBlock x:Uid="SettingsDefaultPlayerButton" Text="Definir como padrão"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock x:Uid="SettingsHelpSection" Text="AJUDA" Margin="4,10,0,0" FontSize="13" FontWeight="SemiBold" Opacity="0.65"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="SettingsKeyboardShortcutsTitle" Text="Atalhos de teclado" FontWeight="SemiBold"/>
                                        <TextBlock x:Uid="SettingsKeyboardShortcutsDescription" Text="Consulte todos os comandos de teclado disponíveis no HC&#160;Player" TextWrapping="Wrap" FontSize="12" Opacity="0.62"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Padding="11,7" CornerRadius="8" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE765;" FontSize="14"/>
                                            <TextBlock x:Uid="SettingsKeyboardShortcutsButton" Text="Ver atalhos"/>
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="TopEdgeAlignedRight">
                                                <ScrollViewer Width="620" MaxHeight="620"
                                                              HorizontalScrollMode="Disabled"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollMode="Enabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Spacing="18" Padding="6,4,12,8">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock x:Uid="KeyboardShortcutsFlyoutTitle" Text="Atalhos de teclado" FontSize="20" FontWeight="SemiBold"/>
                                                            <TextBlock x:Uid="KeyboardShortcutsFlyoutDescription" Text="Comandos atualmente definidos pelo HC Player e pelo preset de teclado do mpv" TextWrapping="Wrap" FontSize="12" Opacity="0.68"/>
                                                            <TextBlock x:Uid="KeyboardShortcutsFlyoutAvailability" Text="Os atalhos de reprodução ficam ativos com os painéis laterais fechados" TextWrapping="Wrap" FontSize="11" Opacity="0.52"/>
                                                        </StackPanel>

                                                            <StackPanel Spacing="7">
                                                                <TextBlock x:Uid="ShortcutSectionAppWindow" Text="APLICATIVO E JANELA" Style="{StaticResource ShortcutSectionTitle}"/>
                                                                <Grid ColumnSpacing="18">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Uid="ShortcutAction001" Text="Abrir arquivo" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
                                                                    <Border Grid.Column="1" Style="{StaticResource ShortcutKeyBadge}">
                                                                        <TextBlock Text="Ctrl + O" FontFamily="Consolas" FontSize="11" TextAlignment="Center"/>
