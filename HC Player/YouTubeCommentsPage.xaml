<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HCPlayer.YouTubeCommentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="CommentsLoaded"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="YouTubeCommentsSurface" Color="#FF202328" />
                    <SolidColorBrush x:Key="YouTubeCommentsSurfaceWindows11" Color="#FF202020" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBrush" Color="#FF272A30" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBrushWindows11" Color="#FF2B2B2B" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBorderBrushWindows11" Color="Transparent" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonBackgroundBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonPointerOverBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonPressedBrush" Color="#4AFFFFFF" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonBorderBrush" Color="Transparent" />
                    <Thickness x:Key="YouTubeCommentsButtonBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="YouTubeCommentsSurface" Color="#FFF5F5F5" />
                    <SolidColorBrush x:Key="YouTubeCommentsSurfaceWindows11" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBrushWindows11" Color="#FFFBFBFB" />
                    <SolidColorBrush x:Key="YouTubeCommentCardBorderBrushWindows11" Color="#16000000" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonPointerOverBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonPressedBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="YouTubeCommentsButtonBorderBrush" Color="#28000000" />
                    <Thickness x:Key="YouTubeCommentsButtonBorderThickness">1</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="YouTubeCommentCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource YouTubeCommentCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YouTubeCommentCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="13,12" />
            </Style>
            <Style x:Key="YouTubeCommentCardWindows11" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource YouTubeCommentCardBrushWindows11}" />
                <Setter Property="BorderBrush" Value="{ThemeResource YouTubeCommentCardBorderBrushWindows11}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="13,12" />
            </Style>

            <Style x:Key="YouTubeCommentsHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource YouTubeCommentsButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource YouTubeCommentsButtonBorderThickness}" />
                <Setter Property="Background" Value="{ThemeResource YouTubeCommentsButtonBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <SolidColorBrush x:Key="YouTubeCommentsReplyAccentBrush"
                             Color="{ThemeResource SystemAccentColor}" />

            <Style x:Key="YouTubeCommentsReplyButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <!-- Reply actions use the exact Windows accent color, matching
                     the HC Player playback accent resources. -->
                <Setter Property="Foreground" Value="{ThemeResource YouTubeCommentsReplyAccentBrush}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="CommentsSurfaceHost" Background="{ThemeResource YouTubeCommentsSurface}">
        <Border x:Name="CommentsRoot" Background="{ThemeResource YouTubeCommentsSurface}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CommentsTranslate" X="0" />
            </Border.RenderTransform>

            <Grid Padding="22,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="CommentsHeader" Margin="0,0,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Uid="YouTubeCommentsHeaderTitle"
                                   x:Name="HeaderTitleText"
                                   Text="Comentários do YouTube"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="YouTubeCommentsHeaderSubtitle"
                                   x:Name="HeaderSubtitleText"
                                   Text="Comentários públicos do vídeo atual"
                                   Margin="0,5,0,0"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Opacity="0.58" />

                        <ComboBox x:Name="SortComboBox"
                                  Margin="0,12,0,0"
                                  MinWidth="158"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="0"
                                  SelectionChanged="SortSelectionChanged">
                            <ComboBoxItem x:Uid="YouTubeCommentsSortRelevant"
                                          Content="Mais relevantes"
                                          Tag="relevance" />
                            <ComboBoxItem x:Uid="YouTubeCommentsSortRecent"
                                          Content="Mais recentes"
                                          Tag="time" />
                        </ComboBox>
                    </StackPanel>

                    <Button x:Uid="YouTubeCommentsRefreshButton"
                            x:Name="RefreshButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Style="{StaticResource YouTubeCommentsHeaderButton}"
                            Click="RefreshClicked"
                            Width="38" Height="38" Padding="0"
                            ToolTipService.ToolTip="Atualizar comentários">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>

                    <Button x:Uid="YouTubeCommentsCloseButton"
                            x:Name="CloseButton"
                            Grid.Column="2"
                            Style="{StaticResource YouTubeCommentsHeaderButton}"
                            Click="CloseClicked"
                            Width="38" Height="38" Padding="0"
                            ToolTipService.ToolTip="Fechar">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                    </Button>
                </Grid>

                <ScrollViewer x:Name="CommentsScrollViewer"
                              Grid.Row="1"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,22,18" Spacing="10">
                        <StackPanel x:Name="LoadingPanel"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Visibility="Collapsed">
                            <ProgressRing x:Name="LoadingRing" Width="24" Height="24" />
                            <TextBlock x:Uid="YouTubeCommentsLoadingText"
                                       x:Name="LoadingText"
                                       Text="Carregando comentários…"
                                       FontSize="12.5"
                                       Opacity="0.62" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                                   Margin="8,18"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Opacity="0.68"
                                   Visibility="Collapsed" />

                        <StackPanel x:Name="CommentsHost" Spacing="8" />

                        <Button x:Uid="YouTubeCommentsLoadMoreButton"
                                x:Name="LoadMoreButton"
                                Content="Carregar mais"
                                Click="LoadMoreClicked"
                                HorizontalAlignment="Center"
                                Padding="16,8"
                                CornerRadius="8"
                                Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
