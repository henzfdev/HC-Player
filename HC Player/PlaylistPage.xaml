<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HCPlayer.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="PlaylistLoaded"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PlaylistSurface" Color="#FF202328" />
                    <SolidColorBrush x:Key="PlaylistCardBrush" Color="#FF272A30" />
                    <SolidColorBrush x:Key="PlaylistCardPointerOverBrush" Color="#FF30343B" />
                    <SolidColorBrush x:Key="PlaylistButtonBackgroundBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="PlaylistButtonPointerOverBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="PlaylistButtonPressedBrush" Color="#4AFFFFFF" />
                    <SolidColorBrush x:Key="PlaylistButtonBorderBrush" Color="Transparent" />
                    <Thickness x:Key="PlaylistButtonBorderThickness">0</Thickness>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PlaylistSurface" Color="#FFF5F5F5" />
                    <SolidColorBrush x:Key="PlaylistCardBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="PlaylistCardPointerOverBrush" Color="#FFF0F0F0" />
                    <SolidColorBrush x:Key="PlaylistButtonBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="PlaylistButtonPointerOverBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="PlaylistButtonPressedBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="PlaylistButtonBorderBrush" Color="#28000000" />
                    <Thickness x:Key="PlaylistButtonBorderThickness">1</Thickness>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="PlaylistCurrentBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.17" />
            <SolidColorBrush x:Key="PlaylistDropIndicatorBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.92" />
            <SolidColorBrush x:Key="PlaylistExternalDropBrush"
                             Color="{ThemeResource SystemAccentColor}"
                             Opacity="0.13" />

            <Style x:Key="PlaylistHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource PlaylistButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource PlaylistButtonBorderThickness}" />
                <Setter Property="Background" Value="{ThemeResource PlaylistButtonBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PlaylistSurfaceHost" Background="{ThemeResource PlaylistSurface}">
        <Border x:Name="PlaylistRoot" Background="{ThemeResource PlaylistSurface}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PlaylistTranslate" X="0" />
            </Border.RenderTransform>

            <Grid Padding="22,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="PlaylistHeader" Margin="0,0,22,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Uid="PlaylistHeaderTitle" Text="Fila de reprodução"
                                   FontFamily="Segoe UI Variable Display"
                                   FontSize="26"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Uid="PlaylistHeaderSubtitle" Text="Itens atuais da playlist"
                                   Margin="0,5,0,0"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Opacity="0.58" />
                    </StackPanel>

                    <Button x:Uid="PlaylistAddButton" x:Name="AddButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Style="{StaticResource PlaylistHeaderButton}"
                            Click="AddClicked"
                            Width="38"
                            Height="38"
                            Padding="0"
                            ToolTipService.ToolTip="Adicionar arquivos à fila">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>

                    <Button x:Uid="PlaylistMoreButton" x:Name="MoreButton"
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            Style="{StaticResource PlaylistHeaderButton}"
                            Width="38"
                            Height="38"
                            Padding="0"
                            ToolTipService.ToolTip="Mais opções da fila">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Uid="PlaylistAddFolderMenuItem"
                                                Text="Adicionar pasta à fila"
                                                Click="AddFolderClicked" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="PlaylistClearQueueMenuItem"
                                                x:Name="ClearQueueMenuItem"
                                                Text="Limpar fila"
                                                Click="ClearQueueClicked" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>

                    <Button x:Uid="PlaylistCloseButton" x:Name="CloseButton"
                            Grid.Column="3"
                            Style="{StaticResource PlaylistHeaderButton}"
                            Click="CloseClicked"
                            Width="38"
                            Height="38"
                            Padding="0"
                            ToolTipService.ToolTip="Fechar">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                    </Button>
                </Grid>

                <ScrollViewer x:Name="PlaylistScrollViewer"
                              Grid.Row="1"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlaylistItemsHost"
                                Margin="0,0,22,18"
                                Spacing="8">
                        <TextBlock x:Uid="PlaylistEmptyText" x:Name="EmptyText"
                                   Text="Nenhum item na fila"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Text"
                                   FontSize="13"
                                   Opacity="0.58"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="ExternalDropOverlay"
                Margin="12"
                Background="{ThemeResource PlaylistExternalDropBrush}"
                BorderBrush="{ThemeResource PlaylistDropIndicatorBrush}"
                BorderThickness="2"
                CornerRadius="12"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <FontIcon Glyph="&#xE710;" FontSize="28" />
                <TextBlock x:Uid="PlaylistExternalDropText"
                           Text="Solte para adicionar à fila"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
